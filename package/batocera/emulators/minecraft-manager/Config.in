config BR2_PACKAGE_MINECRAFT_MANAGER
    bool "minecraft-manager"
    depends on BR2_PACKAGE_QT6
    select BR2_PACKAGE_QT6BASE_GUI
    select BR2_PACKAGE_QT6DECLARATIVE
    select BR2_PACKAGE_QT6DECLARATIVE_QUICK
    select BR2_PACKAGE_QT6IMAGEFORMATS  # Modrinth's icons are mostly WebP
    select BR2_PACKAGE_SDL2
    help
      Manage Minecraft, the Minecraft system's mod manager: browse
      Modrinth, install, update and remove mods for both instances
      (P1 and P2), with a controller. The mod work is done by
      batocera-minecraft-mods from the prismlauncher package.
